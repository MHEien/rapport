
generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// 1. AUTHENTICATION (Better Auth Standard)
// ---------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  
  // App Relations
  posts            Post[]    
  reports          Report[]  // Technicians own their reports
  
  // Organization Relations (Better Auth plugin)
  members          Member[]
  invitations      Invitation[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Organization plugin: active organization
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------
// 2. CORE DOMAIN: REPORTS & FIELD DATA
// ---------------------------------------------------------

model Report {
  id            String       @id @default(cuid())
  reportNumber  Int          @default(autoincrement()) 
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Workflow State
  status        ReportStatus @default(DRAFT)
  
  // Relations
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Job Details
  serviceDate   DateTime     @default(now())
  customerName  String
  customerAddress String?
  contactPerson String?
  
  // Equipment Data
  productName   String       // e.g. "Caterpillar Generator"
  productType   String       // Links to Master Data (ServicePoint)
  serialNumber  String
  runningHours  Float?       
  
  // Data
  type          ReportType   @default(SERVICE)
  checklists    ChecklistResult[]

  // AI & Formatting
  aiSummary     String?      @db.Text // The AI generated "Professional Conclusion"
  overallComment String?     @db.Text
  signatureUrl  String?      // Vercel Blob URL for signature

  @@index([authorId])
  @@index([organizationId])
  @@index([customerName])
  @@index([serialNumber])
}

model ChecklistResult {
  id        String   @id @default(cuid())
  
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Snapshot of the question at time of report
  category  String   
  question  String   
  
  status    ChecklistStatus
  comment   String?  
  
  // Visual Evidence
  photos    Media[]  

  @@index([reportId])
}

model Media {
  id                String   @id @default(cuid())
  url               String   // Vercel Blob URL
  mimeType          String   // "image/jpeg", etc.
  size              Int
  
  // Context
  checklistResultId String?
  checklistResult   ChecklistResult? @relation(fields: [checklistResultId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
}

// ---------------------------------------------------------
// 3. MASTER DATA (Templates)
// ---------------------------------------------------------

model ServicePoint {
  id          String   @id @default(cuid())
  productType String   
  category    String   
  text        String   
  
  isForService       Boolean @default(true)
  isForCommissioning Boolean @default(true)

  // Organization scoping
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productType, category, text])
  @@index([organizationId])
}

model Post {
  id        String     @id @default(cuid())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum ReportType {
  SERVICE
  COMMISSIONING
}

enum ReportStatus {
  DRAFT
  SYNCED
  COMPLETED
  ARCHIVED
}

enum ChecklistStatus {
  OK
  BOR_UTBEDRES  // Should be fixed
  MA_UTBEDRES   // Must be fixed
  IKKE_AKTUELT  // N/A
}

// ---------------------------------------------------------
// 4. MULTI-TENANCY (Better Auth Organization Plugin)
// ---------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  logo        String?
  metadata    String?  // JSON string for extra data
  createdAt   DateTime @default(now())

  members       Member[]
  invitations   Invitation[]
  
  // App Relations
  reports       Report[]
  servicePoints ServicePoint[]

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  role           String   @default("technician")
  createdAt      DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id               String   @id @default(cuid())
  email            String
  role             String   @default("technician")
  status           String   @default("pending") // pending, accepted, rejected, canceled
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviterId        String
  inviter          User         @relation(fields: [inviterId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
